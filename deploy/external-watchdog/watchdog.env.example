# Секреты внешнего watchdog. Скопировать в .env.secrets на хосте-наблюдателе, в git не коммитить.
# Реальные IP и токены живут только здесь и в vault — в трекаемых файлах плейсхолдеры.

# --- Наблюдаемый production-хост ---
WATCHDOG_TARGET_NAME=maxtg-bridge-prod
WATCHDOG_TARGET_HOST=<production_vps_ip>
WATCHDOG_CONTAINER_NAME=deploy-bridge-1
WATCHDOG_SSH_USER=deploy
WATCHDOG_SSH_PORT=22
WATCHDOG_SSH_KEY=/app/ssh/watchdog_key

# --- Telegram: тот же бот, что у bridge, но вызов идёт с этого хоста напрямую ---
TG_BOT_TOKEN=<bridge_bot_token>
TG_OWNER_ID=<owner_id>
TG_FORUM_GROUP_ID=<forum_group_id>
TG_OPS_TOPIC_ID=<ops_topic_id>

# --- Слой 3: push dead-man's switch ---
# Пустой секрет полностью выключает слой 3 (правило push_stale уходит в skip).
WATCHDOG_PUSH_SECRET=<shared_hmac_secret>
WATCHDOG_PUSH_BIND_ADDRESS=0.0.0.0
WATCHDOG_PUSH_PORT=18151

# --- Интервалы и пороги (значения по умолчанию можно не задавать) ---
WATCHDOG_POLL_INTERVAL_SECONDS=60
WATCHDOG_STATUS_INTERVAL_SECONDS=300
WATCHDOG_HEARTBEAT_MAX_AGE_SECONDS=180
WATCHDOG_PUSH_MAX_AGE_SECONDS=300
WATCHDOG_DEDUP_TTL_SECONDS=900
WATCHDOG_EXPECTED_EGRESS=home_ru_proxy
# Сводка состояния: часы UTC через запятую. 6,10,14,18 = 09/13/17/21 МСК.
# off или пусто — выключить.
WATCHDOG_SUMMARY_HOURS_UTC=6,10,14,18
